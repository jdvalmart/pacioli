[Unit]
Description=Daily snapshot of the Pacioli database

[Service]
Type=oneshot
# Adjust the paths if the repository lives elsewhere.
WorkingDirectory=%h/Proyectos/pacioli/backend
ExecStart=%h/Proyectos/pacioli/backend/.venv/bin/python -m app.cli backup
UnsetEnvironment=DATABASE_URL PACIOLI_DATA_DIR
Nice=10
